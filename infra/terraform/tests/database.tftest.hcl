mock_provider "aws" {
  source = "./tests/mocks"
}

variables {
  name              = "tally-test"
  subnet_ids        = ["subnet-a", "subnet-b"]
  security_group_id = "sg-0db"
  kms_key_arn       = "arn:aws:kms:ap-south-1:111122223333:key/test"
}

run "private_encrypted_managed_secret" {
  command = apply

  module {
    source = "./modules/database"
  }

  assert {
    condition     = aws_db_instance.this.publicly_accessible == false
    error_message = "RDS must never be publicly accessible."
  }

  assert {
    condition     = aws_db_instance.this.storage_encrypted && aws_db_instance.this.kms_key_id == var.kms_key_arn
    error_message = "RDS storage must be encrypted with the customer managed key."
  }

  assert {
    condition     = aws_db_instance.this.manage_master_user_password == true && aws_db_instance.this.password == null
    error_message = "The master password must be generated by RDS and stored in Secrets Manager."
  }

  assert {
    condition     = aws_db_instance.this.multi_az && aws_db_instance.this.deletion_protection && aws_db_instance.this.backup_retention_period == 7
    error_message = "Production defaults: Multi-AZ, deletion protection and 7-day backups."
  }

  assert {
    condition     = contains([for p in aws_db_parameter_group.this.parameter : "${p.name}=${p.value}"], "require_secure_transport=1")
    error_message = "MySQL must reject non-TLS connections."
  }

  assert {
    condition     = aws_db_parameter_group.this.family == "mysql8.4"
    error_message = "Parameter group family must follow the engine version."
  }

  assert {
    condition     = startswith(output.master_secret_arn, "arn:aws:secretsmanager:")
    error_message = "Module must expose the managed secret ARN for the web tier."
  }
}

run "rejects_single_subnet" {
  command = plan

  module {
    source = "./modules/database"
  }

  variables {
    subnet_ids = ["subnet-a"]
  }

  expect_failures = [var.subnet_ids]
}

run "rejects_zero_backups" {
  command = plan

  module {
    source = "./modules/database"
  }

  variables {
    backup_retention_days = 0
  }

  expect_failures = [var.backup_retention_days]
}
